---
// Angebote-Sektion (Build-Spec Juni 2026, ersetzt 7.5 vollständig).
// Kopf: waagerechtes Erstgespräch-Band mit dem EINEN großen CTA.
// Darunter drei Spalten: Schritt 2 Praxis-Check · Schritt 3 Umsetzung (5 Baustein-
// Klick-Boxen + Kombi-Hinweis) · Schritt 4 Resonanzraum (leichter, optional).
// Vollständiges System und Methodik-Assistent sind bewusst entfernt.
import Baustein from './Baustein.astro';

const base = import.meta.env.BASE_URL;

const praxischeck = [
  '90-Minuten-Gespräch',
  'schriftlicher Report (PDF, ca. 8 bis 12 Seiten)',
  'drei bis fünf priorisierte Quick Wins mit konkreten Empfehlungen',
  'Bewertung deiner Tools auf DSGVO und EU AI Act',
];

const bausteine = [
  {
    title: 'Sitzungs-Nachbereitung',
    price: 'ab 2.500 €',
    examples: [
      'eine Zusammenfassung für dich nach jeder Sitzung, ohne dass du tippst',
      'auf Wunsch eine klientengerechte Fassung',
      'die Schlüssel-Erkenntnisse und nächsten Schritte als sanfte Erinnerung für deine Klient:innen',
    ],
  },
  {
    title: 'Content-Stimme',
    price: 'ab 4.000 €',
    examples: [
      'die KI lernt, wie du schreibst und formulierst, und schlägt daraus Beiträge und Newsletter vor — in deiner Sprache statt generisch',
      'Grundlage sind deine Texte, Sprachnotizen oder Sitzungs-Transkripte; was am besten passt, schauen wir individuell',
    ],
  },
  {
    title: 'Begleitung zwischen den Sitzungen',
    price: 'ab 2.500 €',
    examples: [
      'Reflexionsfragen und Übungen, die deine Klient:innen zwischen den Terminen tragen',
      'behutsame Erinnerungen ans Vereinbarte',
      'Fortschritt sichtbar gemacht',
    ],
  },
  {
    title: 'Klienten-Aufnahme',
    price: 'ab 3.000 €',
    examples: [
      'ein Erstkontakt, der vorklärt, was die Person mitbringt',
      'ein Erwartungs-Bogen vor dem ersten Termin',
      'Anfragen zeitnah in deinem Ton beantwortet',
    ],
  },
  {
    title: 'Praxis-Gedächtnis',
    price: 'ab 2.500 €',
    examples: [
      'Notizen und Material an einem durchsuchbaren Ort statt verstreut',
      'per Telegram einen Gedanken oder eine Sprachnotiz schicken, die sortiert abgelegt wird',
      'in eigenen Worten nachfragen, was du festgehalten hast',
    ],
  },
];

const resonanzraum = [
  'deine Werkzeuge bleiben auf dem Stand: neue Modelle, bessere Vorlagen',
  'ich halte dich auf dem Laufenden, wenn sich bei DSGVO oder EU AI Act etwas ändert, das dich betrifft — verständlich, nicht als Paragrafen-Flut',
  'Begleitung bei Bedarf',
];
---

<section id="angebote" class="section bg-pergament">
  <div class="container-wide">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16 reveal">
      <p class="eyebrow eyebrow-kupfer mb-5">Schritt für Schritt, in deinem Tempo</p>
      <h2 class="font-serif text-section text-tinte text-balance">
        So gehen wir gemeinsam vor.
      </h2>
    </div>

    <!-- Schritt 1: Erstgespräch — waagerechtes Band, der eine große CTA -->
    <div
      class="reveal max-w-6xl mx-auto rounded-[5px] p-7 md:p-9 lg:p-10 mb-10 md:mb-14 flex flex-col lg:flex-row lg:items-center gap-7 lg:gap-12"
      style="background-color: var(--bg-salbei-soft);"
    >
      <div class="lg:flex-1">
        <p class="eyebrow eyebrow-kupfer mb-3">Schritt 1 — So fangen wir an</p>
        <h3 class="font-serif text-[1.6rem] md:text-[1.9rem] text-tinte font-medium">Erstgespräch</h3>
        <p class="mt-1.5 font-sans text-[0.95rem] text-anthrazit/70">kostenlos · etwa 30 Minuten</p>
        <p class="mt-4 font-sans text-[1.02rem] text-anthrazit leading-[1.65] max-w-2xl">
          Wir lernen uns auf Augenhöhe kennen und klären, ob das zueinander passt. Du erzählst, wo dir im Alltag Zeit und Ruhe verloren gehen. Ich sage offen, was sinnvoll ist und was nicht. Kein Verkaufsgespräch, keine Folien.
        </p>
      </div>
      <div class="lg:flex-shrink-0">
        <a href={`${base}#kontakt`} class="btn-primary w-full lg:w-auto !px-7 !py-3.5">
          Erstgespräch anfragen
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8 L13 8" />
            <path d="M8.5 3.5 L13 8 L8.5 12.5" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Schritt 2–4: drei Spalten -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-7 items-start max-w-6xl mx-auto reveal">

      <!-- Spalte A — Schritt 2: KI-Praxis-Check -->
      <div class="rounded-[5px] border border-holzsand bg-pergament p-6 md:p-7">
        <p class="eyebrow eyebrow-kupfer mb-3">Schritt 2 — Klarheit</p>
        <h3 class="font-serif text-[1.4rem] md:text-[1.5rem] text-tinte font-medium">KI-Praxis-Check</h3>
        <p class="mt-1.5 font-sans text-[0.95rem] text-kupfer font-medium">600 €, voll anrechenbar</p>
        <p class="mt-4 font-sans text-[1rem] text-anthrazit leading-[1.6]">
          Ich schaue mir deine Praxis genau an — du bekommst eine ehrliche Orientierung, wo KI dich wirklich entlastet und wo deine Tools schon reichen.
        </p>

        <details class="angebot-aufklapp mt-5">
          <summary>
            <span>Was du bekommst</span>
            <svg class="chev" width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7 L9 12 L14 7" /></svg>
          </summary>
          <div class="pt-3.5">
            <ul class="space-y-2">
              {praxischeck.map((d) => (
                <li class="flex gap-2.5 items-start font-sans text-[0.92rem] text-anthrazit/85 leading-[1.5]">
                  <span class="block mt-[0.5rem] flex-shrink-0 w-1.5 h-1.5 rounded-full bg-kupfer"></span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3.5 pl-3 border-l-2 border-kupfer/40">
              <p class="font-sans text-[0.88rem] text-anthrazit/75 leading-[1.5]">
                <span class="font-medium text-tinte">Anrechnung: </span>Entscheidest du dich für eine Umsetzung, rechne ich die 600 € vollständig an.
              </p>
            </div>
          </div>
        </details>
      </div>

      <!-- Spalte B — Schritt 3: Umsetzung -->
      <div class="rounded-[5px] border border-holzsand bg-pergament p-6 md:p-7">
        <p class="eyebrow eyebrow-kupfer mb-3">Schritt 3 — Aufbau</p>
        <h3 class="font-serif text-[1.4rem] md:text-[1.5rem] text-tinte font-medium">Umsetzung</h3>
        <p class="mt-1.5 font-sans text-[0.95rem] text-kupfer font-medium">ab 2.500 €</p>
        <p class="mt-4 font-sans text-[1rem] text-anthrazit leading-[1.6]">
          Was sich im Praxis-Check gezeigt hat, baue ich — fertig eingerichtet, DSGVO-konform, in deiner Handschrift.
        </p>

        <p class="mt-5 mb-3 font-sans text-[0.9rem] text-anthrazit/70">
          Du wählst die Bausteine, die zu dir passen. Klick für Beispiele.
        </p>

        <div class="space-y-2.5">
          {bausteine.map((b) => (
            <Baustein title={b.title} price={b.price} examples={b.examples} />
          ))}
          <p class="px-1 pt-1 font-sans text-[0.9rem] text-anthrazit/55 italic">
            und vieles mehr — oder was du sonst für deine Praxis brauchst
          </p>
        </div>

        <div class="mt-5 rounded-[5px] px-4 py-3.5" style="background-color: var(--bg-salbei-soft);">
          <p class="font-sans text-[0.92rem] text-anthrazit/85 leading-[1.55]">
            Mehrere Bausteine richte ich als ein stimmiges Ganzes ein — das ist günstiger als die Summe. Welcher Zuschnitt für dich passt, klären wir im Praxis-Check.
          </p>
        </div>
      </div>

      <!-- Spalte C — Schritt 4: Resonanzraum (leichter, optional) -->
      <div class="rounded-[5px] border border-dashed border-holzsand p-6 md:p-7">
        <p class="eyebrow eyebrow-kupfer mb-3">
          Schritt 4 — Danach <span class="lowercase tracking-normal text-anthrazit/55">(optional)</span>
        </p>
        <h3 class="font-serif text-[1.4rem] md:text-[1.5rem] text-tinte font-medium">Resonanzraum</h3>
        <p class="mt-1.5 font-sans text-[0.95rem] text-kupfer font-medium">ab 300 € pro Monat, ab dem dritten Monat</p>
        <p class="mt-4 font-sans text-[1rem] text-anthrazit leading-[1.6]">
          Auf Wunsch begleite ich dich laufend weiter.
        </p>

        <details class="angebot-aufklapp mt-5">
          <summary>
            <span>Was er trägt</span>
            <svg class="chev" width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7 L9 12 L14 7" /></svg>
          </summary>
          <ul class="pt-3.5 space-y-2">
            {resonanzraum.map((line) => (
              <li class="flex gap-2.5 items-start font-sans text-[0.92rem] text-anthrazit/85 leading-[1.5]">
                <span class="block mt-[0.5rem] flex-shrink-0 w-1.5 h-1.5 rounded-full bg-kupfer"></span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </details>

        <p class="mt-4 font-sans text-[0.9rem] text-anthrazit/65 italic leading-[1.5]">
          Ohne diese Anbindung bleibt deine Umsetzung stabil — du bist nicht abhängig.
        </p>
      </div>
    </div>

    <!-- Querzeile -->
    <p class="reveal mt-10 md:mt-12 max-w-3xl mx-auto text-center font-sans text-[0.92rem] text-anthrazit/60 leading-relaxed">
      Jeder Baustein ist DSGVO- und EU-AI-Act-konform, mit EU-Datenspeicherung. Deine Daten werden nie zum Training von KI verwendet. Routine wie Buchung, Erinnerungen und Rechnungen binde ich an bewährte Tools an.
    </p>

  </div>
</section>

<style>
  /* Inline-Aufklapp für "Was du bekommst" / "Was er trägt" (Spalten A und C) */
  details.angebot-aufklapp summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(217, 199, 168, 0.6);
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-tinte);
    transition: color 180ms ease;
  }
  details.angebot-aufklapp summary::-webkit-details-marker { display: none; }
  details.angebot-aufklapp summary:hover { color: var(--color-kupfer); }
  details.angebot-aufklapp summary .chev {
    flex: 0 0 auto;
    color: var(--color-kupfer);
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  details.angebot-aufklapp[open] summary .chev { transform: rotate(180deg); }
</style>
